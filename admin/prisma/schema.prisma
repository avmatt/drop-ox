generator client {
  provider = "prisma-client"
  output   = "../prisma/generated"
}

datasource db {
  provider = "postgresql"
}

enum ValidationStatus {
  PENDING
  VALID
  INVALID
}

enum ProjectStatus {
  PLANNING
  ACTIVE
  ON_HOLD
  COMPLETED
  CANCELLED
}

model DocumentType {
  id                String            @id @default(cuid())
  kind              String
  name              String
  description       String
  summary           String
  structureHints    Json
  requiredFields    Json
  validationRules   Json
  validationNotes   String
  sampleKeywords    Json
  isActive          Boolean           @default(true)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  documents         Document[]
}

model Project {
  id          String       @id @default(cuid())
  code        String       @unique
  name        String
  client      String
  status      ProjectStatus @default(PLANNING)
  summary     String
  description String
  startDate   DateTime
  endDate     DateTime?
  isActive    Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([status])
  @@index([isActive])
}

model Document {
  id               String           @id @default(cuid())
  documentTypeId   String
  fileName         String
  fileUrl          String?
  extractedData    Json?
  validationStatus ValidationStatus @default(PENDING)
  validationScore  Int?
  validationNotes  String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  documentType DocumentType @relation(fields: [documentTypeId], references: [id], onDelete: Cascade)

  @@index([documentTypeId])
  @@index([validationStatus])
}