generator client {
  provider = "prisma-client"
  output   = "../prisma/generated"
}

datasource db {
  provider = "postgresql"
}

enum ValidationStatus {
  PENDING
  VALID
  INVALID
}

enum ProjectStatus {
  PLANNING
  ACTIVE
  ON_HOLD
  COMPLETED
  CANCELLED
}

enum DocumentRequestStatus {
  DRAFT
  SENT
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model DocumentType {
  id              String                        @id @default(cuid())
  kind            String
  name            String
  description     String
  summary         String
  structureHints  Json
  requiredFields  Json
  validationRules Json
  validationNotes String
  sampleKeywords  Json
  isActive        Boolean                       @default(true)
  createdAt       DateTime                      @default(now())
  updatedAt       DateTime                      @updatedAt
  documents       Document[]
  requestedIn     DocumentRequestDocumentType[]
}

model Project {
  id               String            @id @default(cuid())
  code             String            @unique
  name             String
  client           String
  status           ProjectStatus     @default(PLANNING)
  summary          String
  description      String
  startDate        DateTime
  endDate          DateTime?
  isActive         Boolean           @default(true)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  documentRequests DocumentRequest[]

  @@index([status])
  @@index([isActive])
}

model DocumentRequest {
  id                     String                        @id @default(cuid())
  projectId              String
  recipientEmail         String
  recipientName          String?
  status                 DocumentRequestStatus         @default(DRAFT)
  message                String?
  sentAt                 DateTime?
  createdAt              DateTime                      @default(now())
  updatedAt              DateTime                      @updatedAt
  project                Project                       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  requestedDocumentTypes DocumentRequestDocumentType[]

  @@index([projectId])
  @@index([status])
  @@index([recipientEmail])
}

model DocumentRequestDocumentType {
  id                String          @id @default(cuid())
  documentRequestId String
  documentTypeId    String
  documentRequest   DocumentRequest @relation(fields: [documentRequestId], references: [id], onDelete: Cascade)
  documentType      DocumentType    @relation(fields: [documentTypeId], references: [id], onDelete: Restrict)

  @@unique([documentRequestId, documentTypeId])
  @@index([documentTypeId])
}

model Document {
  id               String           @id @default(cuid())
  documentTypeId   String
  fileName         String
  fileUrl          String?
  extractedData    Json?
  validationStatus ValidationStatus @default(PENDING)
  validationScore  Int?
  validationNotes  String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  documentType     DocumentType     @relation(fields: [documentTypeId], references: [id], onDelete: Cascade)

  @@index([documentTypeId])
  @@index([validationStatus])
}
